var
  FBlob: TBytes = nil;

function DecodeB64: TBytes;
const T='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';
var s: string; i, j, n, acc, bits, outp: Integer; c: Char; map: array[0..255] of Integer;
begin
  Result := nil;
  s := '';
  for i := 0 to High(B64) do s := s + B64[i];
  for i := 0 to 255 do map[i] := -1;
  for i := 1 to Length(T) do map[Ord(T[i])] := i-1;
  SetLength(Result, (Length(s) div 4) * 3 + 3);
  acc := 0; bits := 0; outp := 0;
  for i := 1 to Length(s) do
  begin
    c := s[i];
    if c = '=' then Break;
    n := map[Ord(c)];
    if n < 0 then Continue;
    acc := (acc shl 6) or n; Inc(bits, 6);
    if bits >= 8 then
    begin
      Dec(bits, 8);
      Result[outp] := (acc shr bits) and $FF; Inc(outp);
    end;
  end;
  SetLength(Result, outp);
end;

function FCBlob: TBytes;
begin
  if FBlob = nil then FBlob := DecodeB64;
  Result := FBlob;
end;

function FCSigCount: Integer;
begin
  Result := Length(FCSigs);
end;

function FCSig(AIndex: Integer): TFCSig;
begin
  Result := FCSigs[AIndex];
end;

end.
